 Set-StrictMode -Version Latest
 $root = $PSScriptRoot
-$version = '3.0.2'
+$version = '3.1.0'
 $runId = $version + '-' + (Get-Date -Format 'yyyyMMdd-HHmmss') + '-' + ([guid]::NewGuid().ToString('N').Substring(0, 6))
 $out = Join-Path (Join-Path $root 'SALIDA') $runId
 $clientOut = Join-Path $out 'CLIENTE'
@@ -20,7 +20,7 @@ $previousPythonIo = $env:PYTHONIOENCODING
 $previousConsoleEncoding = [Console]::OutputEncoding
 $previousOutputEncoding = $OutputEncoding
