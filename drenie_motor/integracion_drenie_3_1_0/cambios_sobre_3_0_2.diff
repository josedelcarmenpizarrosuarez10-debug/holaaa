+use sha2::{Digest, Sha256};
+
+pub const ERROR: &str = "Los archivos internos de DrenIE no superaron la comprobación de integridad. Instale nuevamente una copia original.";
+
+pub fn verify(bytes: &[u8], expected: &str) -> Result<(), &'static str> {
+    if format!("{:x}", Sha256::digest(bytes)) == expected { Ok(()) } else { Err(ERROR) }
+}
+
+pub const ASSETS: [(&str, &str); 3] = [
+    ("index.html", env!("DRENIE_ASSET_SHA")),
+    ("splash.html", env!("DRENIE_SPLASH_ASSET_SHA")),
+    ("visor-red.html", env!("DRENIE_VISOR_ASSET_SHA")),
+];
+
+pub fn check_context<R: tauri::Runtime>(context: &tauri::Context<R>) -> Result<(), &'static str> {
+    for (name, expected) in ASSETS {
+        let bytes = context.assets().get(&name.into()).ok_or(ERROR)?;
+        verify(&bytes, expected)?;
+    }
+    Ok(())
+}
+
+// Tauri's raw asset iterator yields Brotli-compressed data (unlike assets().get()).
+pub fn verify_compressed_with(bytes: &[u8], expected: &str) -> Result<(), &'static str> {
+    let mut html = Vec::new();
+    brotli::BrotliDecompress(&mut std::io::Cursor::new(bytes), &mut html).map_err(|_| ERROR)?;
+    verify(&html, expected)
+}
+
+pub fn show_error() {
+    #[cfg(target_os = "windows")]
+    {
+        let title: Vec<u16> = "DrenIE — Integridad".encode_utf16().chain(Some(0)).collect();
+        let message: Vec<u16> = ERROR.encode_utf16().chain(Some(0)).collect();
+        unsafe { windows_sys::Win32::UI::WindowsAndMessaging::MessageBoxW(
+            std::ptr::null_mut(), message.as_ptr(), title.as_ptr(),
+            windows_sys::Win32::UI::WindowsAndMessaging::MB_OK | windows_sys::Win32::UI::WindowsAndMessaging::MB_ICONERROR
+        ); }
+    }
+    #[cfg(not(target_os = "windows"))]
+    eprintln!("{ERROR}");
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn source_hash_matches_final_html() {
+        assert!(verify(include_bytes!("../../src/index.html"), env!("DRENIE_HTML_SHA")).is_ok());
+        assert!(verify(include_bytes!("../../src/splash.html"), env!("DRENIE_SPLASH_SHA")).is_ok());
+    }
+    #[test]
+    fn embedded_asset_matches_expected_hash() {
+        assert!(check_context::<tauri::Wry>(&tauri::generate_context!()).is_ok());
+    }
+    #[test]
+    fn iterator_asset_is_verified_after_decompression() {
+        let context: tauri::Context<tauri::Wry> = tauri::generate_context!();
+        let (_, bytes) = context.assets().iter().find(|(key, _)| key.as_ref().trim_start_matches('/') == "index.html").unwrap();
+        assert!(verify_compressed_with(&bytes, env!("DRENIE_ASSET_SHA")).is_ok());
+        assert!(verify_compressed_with(b"broken compression", env!("DRENIE_ASSET_SHA")).is_err());
+        let (_, splash) = context.assets().iter().find(|(key, _)| key.as_ref().trim_start_matches('/') == "splash.html").unwrap();
+        assert!(verify_compressed_with(&splash, env!("DRENIE_SPLASH_ASSET_SHA")).is_ok());
+        assert!(verify_compressed_with(&splash, env!("DRENIE_ASSET_SHA")).is_err());
+    }
+    #[test]
+    fn rejects_changed_missing_or_wrong_hash() {
+        let original = b"DrenIE: licencia comprobada";
+        let hash = format!("{:x}", Sha256::digest(original));
+        assert!(verify(original, &hash).is_ok());
+        let mut altered = original.to_vec(); altered[0] ^= 1;
+        assert!(verify(&altered, &hash).is_err());
+        assert!(verify(b"", &hash).is_err());
+        assert!(verify(original, "").is_err());
