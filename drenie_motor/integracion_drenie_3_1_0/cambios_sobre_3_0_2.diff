+$manifest = [ordered]@{ version = $version; startedUtc = [DateTime]::UtcNow.ToString('o'); status = 'EN_PROCESO'; artifacts = @(); scope = 'Instaladores compilados desde fuentes 3.1.0; aceptación manual registrada por separado.' }
 
 function Save-Manifest {
   $manifest['artifacts'] = @($script:records)
@@ -100,6 +100,9 @@ try {
   Set-Location (Join-Path $root 'client')
