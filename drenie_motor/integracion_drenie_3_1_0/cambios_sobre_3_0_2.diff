diff --git a/client/v3/theme-v3.css b/client/v3/theme-v3.css
index cbb482a..f6ffcf3 100644
--- a/client/v3/theme-v3.css
+++ b/client/v3/theme-v3.css
@@ -404,3 +404,50 @@ body.ui-cinta .v3-steps{display:none!important}
 @media print{.v3-dlg-overlay{display:none!important}}
 
 .ws-settings>.page-head{display:block}
+
+/* ===== DrenIE 3.1.0 · Red de cunetas ===== */
+.rc-page.rc-con-visor{gap:10px}
+.rc-cab{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
+.rc-cab>div{flex:1;min-width:0}
+.rc-cab h1{margin:0;font-size:22px}
+.rc-ruta{display:inline-block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;vertical-align:middle;font-size:11px;color:var(--ink-soft)}
+.rc-chip{border-radius:99px;padding:4px 12px;font-weight:600;font-size:11px;background:#E0F2FE;color:#0B6FC0}
+.rc-chip.pend{background:#FCE7F3;color:#B0127F}
+.rc-chip.ok{background:#DCFCE7;color:#12784F}
+.rc-visor{padding:0!important;overflow:hidden}
+.rc-visor iframe{display:block;width:100%;height:calc(100vh - var(--ws-ribbon-h,166px) - 165px);min-height:460px;border:0;border-radius:18px;background:#fff}
+.rc-recientes{display:flex;flex-direction:column;gap:6px}
+.rc-reciente{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2px 12px;text-align:left;border:1px solid var(--line);border-radius:12px;background:var(--surface-2);padding:10px 14px;cursor:pointer;font-family:inherit;color:var(--ink)}
+.rc-reciente small{grid-column:1;color:var(--ink-soft);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.rc-reciente em{grid-row:1/3;grid-column:2;align-self:center;font-style:normal;font-size:11px;color:var(--ink-soft)}
+.rc-reciente:hover{border-color:#9FD4FA;background:#E8F4FE}
+.rc-velo-caja{min-width:min(440px,90vw)}
+.rc-barra{height:4px;background:#E4ECF4;border-radius:2px;overflow:hidden;margin-top:12px}
+.rc-barra i{display:block;height:100%;width:40%;background:linear-gradient(90deg,#1EA7F2,#0B6FC0);animation:rcIr 1.3s ease-in-out infinite}
+@keyframes rcIr{from{transform:translateX(-100%)}to{transform:translateX(260%)}}
+@media (prefers-reduced-motion:reduce){.rc-barra i{animation:none;width:100%}}
+.ws-file-action svg{flex:none}
+.rc-lluvia{display:flex;align-items:center;gap:16px;flex-wrap:wrap;border:1px solid var(--line);border-left:4px solid var(--brand);border-radius:12px;background:var(--surface-2);padding:12px 16px;margin:6px 0 12px}
+.rc-lluvia>div{flex:1;min-width:220px;display:flex;flex-direction:column;gap:2px}
+.rc-lluvia span{font-size:11px;color:var(--ink-soft);letter-spacing:.5px;text-transform:uppercase}
+.rc-lluvia b{font-size:20px;color:var(--ink)}
+.rc-lluvia small{color:var(--ink-soft);line-height:1.5}
+.rc-lluvia.ejemplo{border-left-color:#E08A12}
+.rc-lluvia.falta{border-left-color:#D61F9A}
+.rc-datos{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:12px}
+.rc-dato{border:1px solid var(--line);border-radius:12px;padding:12px 14px;background:#fff;display:flex;flex-direction:column;gap:8px;min-width:0}
+.rc-dato-cab{display:flex;justify-content:space-between;gap:10px;align-items:baseline}
+.rc-dato-cab span{font-weight:600;color:var(--ink)}
+.rc-dato-cab span{min-width:0}
+.rc-dato-cab b{color:var(--brand-dark);text-align:right;max-width:55%;overflow-wrap:anywhere}
+.rc-fuente{border-left:4px solid var(--brand);background:#EEF6FD;border-radius:8px;padding:8px 12px;font-size:11.5px;line-height:1.55;color:var(--ink)}
+.rc-fuente b{color:var(--brand-dark)}
+.rc-clase{display:inline-block;border-radius:99px;padding:1px 9px;font-size:10px;font-weight:600;background:#E0F2FE;color:#0B6FC0}
+.rc-clase.criterio{background:#EDE9FE;color:#5B21B6}
+.rc-clase.referencia{background:#E0F2FE;color:#0B6FC0}
+.rc-clase.norma{background:#DCFCE7;color:#12784F}
+.rc-est{display:inline-block;border-radius:99px;padding:1px 9px;font-size:10px;font-weight:600}
+.rc-est.ok{background:#DCFCE7;color:#12784F}
+.rc-est.pend{background:#FFF4D6;color:#9A5B00}
+.rc-tabla{width:100%;border-collapse:collapse;margin:8px 0 10px}
+.rc-tabla th,.rc-tabla td{border:1px solid var(--line);padding:6px 10px;text-align:left;font-size:12px}
