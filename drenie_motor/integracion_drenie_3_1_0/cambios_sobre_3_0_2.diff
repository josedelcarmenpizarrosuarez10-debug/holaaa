+  $claveAct = Join-Path $env:USERPROFILE 'DrenIE_Actualizaciones_PRIVADO\drenie-actualizaciones.key'
+  $argsCliente = @('build', '--', '--locked')
+  if (Test-Path -LiteralPath $claveAct) {
