+  Remove-Item Env:TAURI_SIGNING_PRIVATE_KEY, Env:TAURI_SIGNING_PRIVATE_KEY_PASSWORD -ErrorAction SilentlyContinue
   Copy-Installer "DrenIE_${version}_x64-setup.exe" $clientOut 'CLIENTE' $started
